#include <stdio.h>
#include <stdlib.h>

// Macro to find the maximum of two values
#define MAX(a, b) ((a) > (b) ? (a) : (b))

int main() {
    // Fast I/O for performance
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    // Allocate memory for the input array
    int *a = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) return 0;
    }
    
    // Allocate memory for the monotonic stack
    int *stack = (int *)malloc(n * sizeof(int));
    int top = -1; // Stack pointer (-1 means empty)
    int max_xor = 0;
    
    // Process the array using the monotonic stack logic
    for (int i = 0; i < n; i++) {
        while (top >= 0) {
            // Calculate XOR for the current pair candidate
            int current_xor = a[i] ^ stack[top];
            max_xor = MAX(max_xor, current_xor);
            
            // If current element is smaller than stack top, pop it
            if (a[i] < stack[top]) {
                top--;
            } else {
                // If current element is larger, it forms a valid pair but we stop popping
                break;
            }
        }
        // Push the current element onto the stack
        stack[++top] = a[i];
    }
    
    // Print the maximum possible value found
    printf("%d\n", max_xor);
    
    // Free allocated memory
    free(a);
    free(stack);
    
    return 0;
}
