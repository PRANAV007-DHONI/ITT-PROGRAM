#include <stdio.h>
#include <stdlib.h>

/*
 * Complete the 'rotateLeft' function below.
 *
 * The function is expected to return an INTEGER_ARRAY.
 * The function accepts following parameters:
 *  1. INTEGER d
 *  2. INTEGER_ARRAY arr
 */
int* rotateLeft(int d, int arr_count, int* arr, int* result_count) {
    // 1. Set the size of the returned array
    *result_count = arr_count;
    
    // 2. Allocate memory for the new rotated array
    int* rotated_arr = (int*)malloc(arr_count * sizeof(int));
    
    // 3. Map each index directly to its new position
    for (int i = 0; i < arr_count; i++) {
        // The element at new index 'i' comes from old index '(i + d) % arr_count'
        int old_index = (i + d) % arr_count;
        rotated_arr[i] = arr[old_index];
    }
    
    return rotated_arr;
}

int main() {
    int n, d;
    if (scanf("%d %d", &n, &d) != 2) return 0;

    // Allocate memory for the initial array
    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) return 0;
    }

    int result_count = 0;
    // Execute the rotation algorithm
    int* result = rotateLeft(d, n, arr, &result_count);
    
    // Print the rotated array elements separated by a space
    for (int i = 0; i < result_count; i++) {
        printf("%d", result[i]);
        if (i < result_count - 1) {
            printf(" ");
        }
    }
    printf("\n");

    // Free all dynamically allocated memory blocks
    free(arr);
    free(result);

    return 0;
}
