#include <stdio.h>
#include <stdlib.h>

// Helper macro to find the maximum of two values
#define MAX(x, y) ((x) > (y) ? (x) : (y))

/*
 * Complete the 'twoStacks' function below.
 *
 * The function is expected to return an INTEGER.
 * The function accepts following parameters:
 *  1. INTEGER maxSum
 *  2. INTEGER_ARRAY a
 *  3. INTEGER_ARRAY b
 *  4. INTEGER a_count
 *  5. INTEGER b_count
 */
int twoStacks(int maxSum, int a_count, int* a, int b_count, int* b) {
    int i = 0; // Number of elements taken from stack A
    int j = 0; // Number of elements taken from stack B
    long long current_sum = 0;
    int max_score = 0;

    // 1. Take as many elements from stack A as possible without exceeding maxSum
    while (i < a_count && current_sum + a[i] <= maxSum) {
        current_sum += a[i];
        i++;
    }
    
    // Base record using only stack A elements
    max_score = i;

    // 2. Try to add elements from stack B while adjusting stack A count
    while (j < b_count) {
        current_sum += b[j];
        j++;

        // If current_sum exceeds maxSum, give back elements from stack A
        while (current_sum > maxSum && i > 0) {
            i--;
            current_sum -= a[i];
        }

        // If the sum is now valid, check if this combination sets a new record
        if (current_sum <= maxSum) {
            max_score = MAX(max_score, i + j);
        } else {
            // If we've given back all elements of A and the sum is still too big,
            // we can't take any more elements from B either.
            break;
        }
    }

    return max_score;
}

int main() {
    int g;
    if (scanf("%d", &g) != 1) return 0;

    while (g--) {
        int n, m, max_sum;
        if (scanf("%d %d %d", &n, &m, &max_sum) != 3) return 0;

        int* a = (int*)malloc(n * sizeof(int));
        for (int i = 0; i < n; i++) {
            if (scanf("%d", &a[i]) != 1) return 0;
        }

        int* b = (int*)malloc(m * sizeof(int));
        for (int i = 0; i < m; i++) {
            if (scanf("%d", &b[i]) != 1) return 0;
        }

        int result = twoStacks(max_sum, n, a, m, b);
        printf("%d\n", result);

        free(a);
        free(b);
    }

    return 0;
}
