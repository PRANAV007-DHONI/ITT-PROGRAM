#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_TOTAL_LEN 1000005

// Global or dynamically allocated array to hold the current string state
char current_str[MAX_TOTAL_LEN];
int current_len = 0;

// Stack to hold the historical states of the string for undo operations
char* history_stack[MAX_TOTAL_LEN];
int history_top = -1;

// Push a copy of the current string state to the history stack
void push_history() {
    history_top++;
    // Allocate exactly the memory needed for the current string state
    history_stack[history_top] = (char*)malloc((current_len + 1) * sizeof(char));
    strcpy(history_stack[history_top], current_str);
}

// Revert to the last saved state from the history stack
void pop_undo() {
    if (history_top >= 0) {
        strcpy(current_str, history_stack[history_top]);
        current_len = strlen(current_str);
        free(history_stack[history_top]);
        history_top--;
    }
}

int main() {
    int q;
    if (scanf("%d", &q) != 1) return 0;

    // Prefill current string as empty
    current_str[0] = '\0';

    char buffer[MAX_TOTAL_LEN];

    for (int i = 0; i < q; i++) {
        int type;
        scanf("%d", &type);

        if (type == 1) {
            // Append operation
            scanf("%s", buffer);
            push_history();
            
            // Efficient append by copying directly to the end pointer
            strcpy(current_str + current_len, buffer);
            current_len += strlen(buffer);
        } 
        else if (type == 2) {
            // Delete operation
            int k;
            scanf("%d", &k);
            push_history();
            
            current_len -= k;
            current_str[current_len] = '\0';
        } 
        else if (type == 3) {
            // Print operation (1-based index)
            int k;
            scanf("%d", &k);
            printf("%c\n", current_str[k - 1]);
        } 
        else if (type == 4) {
            // Undo operation
            pop_undo();
        }
    }

    // Free any remaining memory left in the history stack
    while (history_top >= 0) {
        free(history_stack[history_top]);
        history_top--;
    }

    return 0;
}
