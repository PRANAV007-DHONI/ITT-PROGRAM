
#include <stdio.h>
#include <stdlib.h>

// Helper macro to find the maximum of two 64-bit values
#define MAX(a, b) ((a) > (b) ? (a) : (b))

/*
 * Complete the 'largestRectangle' function below.
 *
 * The function is expected to return a LONG_INTEGER.
 * The function accepts INTEGER_ARRAY h as parameter.
 */
long long largestRectangle(int h_count, int* h) {
    // Allocate memory for our monotonic stack to hold indices
    // We add 1 to h_count to accommodate an extra flush index element
    int* stack = (int*)malloc((h_count + 1) * sizeof(int));
    int top = -1;
    
    long long max_area = 0;
    int i = 0;
    
    while (i <= h_count) {
        // Use a dummy height of 0 at the end to flush out any remaining elements in the stack
        int current_height = (i == h_count) ? 0 : h[i];
        
        // If stack is empty or current height is higher or equal, push it onto the stack
        if (top == -1 || current_height >= h[stack[top]]) {
            stack[++top] = i;
            i++;
        } else {
            // Pop the top element and calculate its maximal rectangular space boundaries
            int popped_idx = stack[top--];
            long long height = h[popped_idx];
            
            // If the stack is empty, it means the popped building was the shortest seen so far,
            // so the width extends all the way from index 0 to i.
            long long width = (top == -1) ? i : (i - stack[top] - 1);
            
            long long current_area = height * width;
            max_area = MAX(max_area, current_area);
        }
    }
    
    free(stack);
    return max_area;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    int* h = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &h[i]) != 1) return 0;
    }
    
    long long result = largestRectangle(n, h);
    printf("%lld\n", result);
    
    free(h);
    return 0;
}
