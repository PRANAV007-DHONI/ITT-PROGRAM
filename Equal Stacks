#include <stdio.h>
#include <stdlib.h>

/*
 * Complete the 'equalStacks' function below.
 *
 * The function is expected to return an INTEGER.
 * The function accepts following parameters:
 *  1. INTEGER_ARRAY h1
 *  2. INTEGER_ARRAY h2
 *  3. INTEGER_ARRAY h3
 */
int equalStacks(int h1_count, int* h1, int h2_count, int* h2, int h3_count, int* h3) {
    long long sum1 = 0, sum2 = 0, sum3 = 0;

    // Calculate total height for stack 1
    for (int i = 0; i < h1_count; i++) sum1 += h1[i];
    // Calculate total height for stack 2
    for (int i = 0; i < h2_count; i++) sum2 += h2[i];
    // Calculate total height for stack 3
    for (int i = 0; i < h3_count; i++) sum3 += h3[i];

    int i = 0, j = 0, k = 0;

    // Keep reducing the tallest stack until all three stacks have equal height
    while (1) {
        // Check if all stacks are equalized
        if (sum1 == sum2 && sum2 == sum3) {
            return sum1;
        }

        // If any stack becomes completely empty, they can only be equal at height 0
        if (i >= h1_count || j >= h2_count || k >= h3_count) {
            return 0;
        }

        // Pop from the stack that is currently the tallest
        if (sum1 >= sum2 && sum1 >= sum3) {
            sum1 -= h1[i++];
        } else if (sum2 >= sum1 && sum2 >= sum3) {
            sum2 -= h2[j++];
        } else if (sum3 >= sum1 && sum3 >= sum2) {
            sum3 -= h3[k++];
        }
    }
}

int main() {
    int n1, n2, n3;
    if (scanf("%d %d %d", &n1, &n2, &n3) != 3) return 0;

    int* h1 = (int*)malloc(n1 * sizeof(int));
    for (int i = 0; i < n1; i++) {
        if (scanf("%d", &h1[i]) != 1) return 0;
    }

    int* h2 = (int*)malloc(n2 * sizeof(int));
    for (int i = 0; i < n2; i++) {
        if (scanf("%d", &h2[i]) != 1) return 0;
    }

    int* h3 = (int*)malloc(n3 * sizeof(int));
    for (int i = 0; i < n3; i++) {
        if (scanf("%d", &h3[i]) != 1) return 0;
    }

    int result = equalStacks(n1, h1, n2, h2, n3, h3);
    printf("%d\n", result);

    // Free heap memory
    free(h1);
    free(h2);
    free(h3);

    return 0;
}

