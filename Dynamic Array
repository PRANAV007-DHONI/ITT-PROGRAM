#include <stdio.h>
#include <stdlib.h>

/*
 * Complete the 'dynamicArray' function below.
 *
 * The function is expected to return an INTEGER_ARRAY.
 * The function accepts following parameters:
 *  1. INTEGER n
 *  2. 2D_INTEGER_ARRAY queries
 *  3. 2D_INTEGER_ARRAY_ROWS queries_rows
 *  4. 2D_INTEGER_ARRAY_COLS queries_columns
 *  5. Pointer to an integer to store the returned array size (result_count)
 */
int* dynamicArray(int n, int** queries, int queries_rows, int queries_columns, int* result_count) {
    // 1. Allocate a 2D-like structure with 'n' empty arrays 
    // along with a tracking array for each inner array's current size
    int** arr = (int**)malloc(n * sizeof(int*));
    int* arr_sizes = (int*)calloc(n, sizeof(int));
    for (int i = 0; i < n; i++) {
        arr[i] = NULL; 
    }

    // 2. Allocate memory for storing type-2 query results
    int* answers = (int*)malloc(queries_rows * sizeof(int));
    int ans_idx = 0;
    
    // Initialize lastAnswer to 0
    int last_answer = 0;

    // 3. Process each query
    for (int i = 0; i < queries_rows; i++) {
        int query_type = queries[i][0];
        int x = queries[i][1];
        int y = queries[i][2];

        // Compute index bucket using the formula
        int idx = (x ^ last_answer) % n;

        if (query_type == 1) {
            // Query 1: Append y to arr[idx]
            int current_size = arr_sizes[idx];
            arr[idx] = (int*)realloc(arr[idx], (current_size + 1) * sizeof(int));
            arr[idx][current_size] = y;
            arr_sizes[idx]++;
        } 
        else if (query_type == 2) {
            // Query 2: Find element at index y % size(arr[idx])
            int size_of_idx = arr_sizes[idx];
            int element_idx = y % size_of_idx;
            
            last_answer = arr[idx][element_idx];
            answers[ans_idx++] = last_answer;
        }
    }

    // 4. Clean up the dynamic arrays used for processing
    for (int i = 0; i < n; i++) {
        if (arr[i] != NULL) {
            free(arr[i]);
        }
    }
    free(arr);
    free(arr_sizes);

    // 5. Update the result counter pointer and return answers
    *result_count = ans_idx;
    return answers;
}

int main() {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;

    // Allocate memory for the 2D queries array
    int** queries = (int**)malloc(q * sizeof(int*));
    for (int i = 0; i < q; i++) {
        queries[i] = (int*)malloc(3 * sizeof(int));
        if (scanf("%d %d %d", &queries[i][0], &queries[i][1], &queries[i][2]) != 3) return 0;
    }

    int result_count = 0;
    // Execute the algorithm
    int* result = dynamicArray(n, queries, q, 3, &result_count);
    
    // Output the final answers array
    for (int i = 0; i < result_count; i++) {
        printf("%d\n", result[i]);
    }

    // Free all dynamically allocated memory from main
    free(result);
    for (int i = 0; i < q; i++) {
        free(queries[i]);
    }
    free(queries);

    return 0;
}
